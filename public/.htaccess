# ----------------------------------------------------------------------
# Skyrim Mod Organizer & Load Order Tracker - IONOS Webspace .htaccess
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other requests to index.html for Single Page Application
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Gzip Compression (mod_deflate)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching Rules
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Never cache HTML so updates load instantly
  ExpiresByType text/html "access plus 0 seconds"

  # Cache hashed JS, CSS, and Fonts for 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ----------------------------------------------------------------------
# Security & Privacy Headers (Hidden from All Search Engines & Bots)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Tell all search engines and spiders at the HTTP server level to never index
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# ----------------------------------------------------------------------
# Block Known Automated Web Scrapers & Commercial Crawlers
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|MJ12bot|DotBot|Baiduspider|Bytespider|PetalBot|ZoominfoBot|CriteoBot|Seekport) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# Optional: 100% Password Protection (HTTP Basic Authentication)
# ----------------------------------------------------------------------
# If you wish to password-protect this folder so only YOU can load it:
# 1. In your IONOS Control Panel, go to: Hosting -> Webspace -> Directory Protection.
# 2. Select "/skyrim-mod-tracker" and create a Username and Password.
# ----------------------------------------------------------------------
